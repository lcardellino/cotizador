// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Trip {
  id         Int      @id @default(autoincrement())
  distance   Float?
  passengers Int?
  location   String?
  type       String?
  scope      String?
  date       DateTime @default(now())
}

model Vehicle {
  id             String  @id
  plate          String
  internalNumber String
  unitType       String
  brand          String
  model          String
  status         String
  rtoNacional    String?
  rtoProvincial  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SavedBudget {
  id            String  @id
  userId        String
  budgetNumber  String
  status        String
  paymentStatus String?
  date          String
  client        String
  time          String
  destination   String
  km            Float
  cost          Float
  profit        Float
  finalPrice    Float
  contact       String
  phone         String
  tripType      String
  passengers    Int
  timestamp     Float

  // Extra fields for PDF export
  mail             String?
  origen           String?
  regresoA         String?
  fechaRegreso     String?
  horaRegreso      String?
  descripcion      String?
  subtotal         Float?
  ivaAmount        Float?
  carCost          Float?
  depreciationCost Float?
  totalDriverCost  Float?
  dirtRoadCost     Float?

  // Full state fields
  kmProductivos     Float?
  kmDestino         Float?
  kmImproductivos   Float?
  unitType          String?
  dieselPrice       Float?
  driverCount       Int?
  busCount          Int?
  driverServiceType String?
  dirtRoadPercent   Float?
  profitMultiplier  Float?

  // JSON fields for complex objects
  driverShift       String?
  driverViatico     String?
  driverTomeDeje    String?
  driverExtraHour   String?
  driverBed         String?
  natBreakfast      String?
  natLunch          String?
  natSnack          String?
  natDinner         String?
  natBed            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
